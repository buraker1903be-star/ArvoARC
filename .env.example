# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://<proje-ref>.supabase.co
# Yalnızca publishable/anon anahtar; güvenlik RLS politikalarından gelir.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Yalnızca sunucu tarafı. RLS'i atlar: PayTR bildirimi ve tedarikçi içe
# aktarma uçları bunu kullanır, yetkiyi kendileri doğrular.
# ASLA NEXT_PUBLIC_ ile başlatmayın. Eksikse ilgili uçlar açık hatayla durur.
SUPABASE_SERVICE_ROLE_KEY=

# --- Mağaza PayTR anahtarlarının şifrelenmesi ---
# Anahtarlar mağaza başınadır: her mağaza kendi PayTR bilgilerini panelden
# girer, arc_store_settings'te AES-256-GCM ile şifreli saklanır
# (src/lib/payment-credentials.ts). 32 baytlık base64:
#   openssl rand -base64 32
# Bu değer değişirse şifreli kayıtlar okunamaz hale gelir.
PAYMENT_CREDENTIALS_KEY=

# --- PayTR: eski mağaza (geçiş dönemi) ---
# Aşağıdaki üç anahtar ArvoCulture'ın KENDİ PayTR hesabına aittir, ARC'ın
# değil. Yalnızca slug'ı PAYTR_LEGACY_ORGANIZATION_SLUG ile eşleşen tek
# mağaza için kullanılır (src/lib/paytr/config.ts). Yeni mağazalar bunları
# KULLANMAZ — kullanırsa tahsilatları ArvoCulture'ın hesabına düşer.
# Geçiş tamamlandığında dördü de silinebilir.
PAYTR_LEGACY_ORGANIZATION_SLUG=
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=

# DİKKAT: tanımlı değilse test moduna düşer ("1"). Yani canlıda bu satır
# unutulursa eski mağazanın ödemeleri GERÇEKTEN TAHSİL EDİLMEZ.
# Canlıya almak için açıkça "0" yazın.
PAYTR_TEST_MODE=0

# --- Vitrin adresi ---
# Sipariş e-postalarındaki bağlantılar ve origin karşılaştırması bunu kullanır
# (src/lib/storefront-origin.ts). Boş bırakılırsa https://arvoculture.com.
STOREFRONT_URL=

# --- E-posta gönderimi (Resend) ---
# Anahtar yoksa gönderim sessizce atlanır: sipariş akışı bozulmaz, yalnızca
# posta gitmez (src/lib/email/resend.ts). Canlıda mutlaka tanımlayın.
RESEND_API_KEY=

# --- Zamanlanmış görev ve tedarikçi aktarımı ---
# /api/tedarikci/ice-aktar iki ayrı yoldan çağrılabilir: Vercel Cron (GET,
# CRON_SECRET) ve tedarikçi tarafı (POST, SUPPLIER_SYNC_SECRET). İkisi de
# Authorization: Bearer <değer> bekler ve sabit zamanlı karşılaştırılır.
# Değişken tanımlı değilse uç herkese 401 döner (kapalı başarısızlık).
CRON_SECRET=
SUPPLIER_SYNC_SECRET=

# --- Vercel alan adı otomasyonu ---
# Mağaza kendi alan adını panelden bağlar (src/lib/vercel-domains.ts).
# Eksikse yalnızca bu ekran hata verir, panelin geri kalanı etkilenmez.
ARVO_VERCEL_TOKEN=
ARVO_VERCEL_TEAM_ID=
ARVO_VERCEL_PANEL_PROJECT_ID=
ARVO_VERCEL_STOREFRONT_PROJECT_ID=

# Eski adlar; ARVO_ önekliler tanımlı değilse yedek olarak okunur.
# Yeni kurulumda gerekmez.
# VERCEL_AUTOMATION_TOKEN=
# VERCEL_AUTOMATION_TEAM_ID=
# VERCEL_PANEL_PROJECT_ID=
# VERCEL_STOREFRONT_PROJECT_ID=
